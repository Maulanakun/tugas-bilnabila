# Salin file ini menjadi .env lalu isi. JANGAN commit file .env.
# Di Netlify: isi lewat Site configuration > Environment variables (bukan lewat file).

# ---- WAJIB di Netlify / produksi ----
# Kunci rahasia untuk menandatangani token login. Minimal 16 karakter, sebaiknya 64 hex acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- OPSIONAL (Netlify & lokal) ----
# Token untuk mengunduh seluruh database JSON lewat GET /api/admin/export.
# Kosongkan = endpoint admin mati (404).
ADMIN_TOKEN=

# Kata kunci admin: siapa pun yang mendaftar/masuk dengan kata sandi yang MENGANDUNG teks ini
# otomatis menjadi admin. Default ADMINGOUTCARE. Ganti dengan teks rahasia milikmu sendiri.
ADMIN_KEY=ADMINGOUTCARE

# Isi false untuk menutup pendaftaran akun baru (mis. setelah akun Anda sendiri dibuat).
ALLOW_REGISTER=true

# Masa berlaku login (hari). Default 30.
TOKEN_TTL_DAYS=30

# ---- HANYA untuk server lokal (npm start); diabaikan di Netlify ----
PORT=3000
HOST=127.0.0.1
# Lokasi file database JSON lokal. Default: data/db.json
DATA_FILE=data/db.json

# ---- PENGINGAT EMAIL (SMTP lewat nodemailer) ----
# Contoh Gmail: host smtp.gmail.com, port 587 (atau 465), user = alamat Gmail,
# pass = "App Password" 16 huruf dari akun Google (BUKAN sandi Gmail biasa).
# ---- PENGINGAT EMAIL (SMTP lewat nodemailer) ----
# Contoh Gmail: host smtp.gmail.com, port 587 (atau 465).
# Isi nilai sebenarnya di file .env lokal atau Environment variables Netlify.
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Opsional. Kosong = "Gout Care <SMTP_USER>".

MAIL_FROM=

# Zona waktu jam pengingat. Default Asia/Jakarta (WIB).

REMINDER_TZ=Asia/Jakarta

# Alamat aplikasi untuk tombol "Buka Gout Care" di email.

APP_URL=

# Isi "log" untuk pengujian lokal tanpa mengirim email.

MAIL_MODE=

# Lokal saja: false untuk mematikan penjadwal pengingat.

REMINDERS_ENABLED=true