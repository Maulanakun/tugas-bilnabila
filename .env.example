# Salin file ini menjadi .env lalu isi. JANGAN commit file .env.
# Di Netlify: isi lewat Site configuration > Environment variables (bukan lewat file).

# ---- WAJIB di Netlify / produksi ----
# Kunci rahasia untuk menandatangani token login. Minimal 16 karakter, sebaiknya 64 hex acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- OPSIONAL (Netlify & lokal) ----
# Token untuk mengunduh seluruh database JSON lewat GET /api/admin/export.
# Kosongkan = endpoint admin mati (404).
ADMIN_TOKEN=

# Isi false untuk menutup pendaftaran akun baru (mis. setelah akun Anda sendiri dibuat).
ALLOW_REGISTER=true

# Masa berlaku login (hari). Default 30.
TOKEN_TTL_DAYS=30

# ---- HANYA untuk server lokal (npm start); diabaikan di Netlify ----
PORT=3000
HOST=127.0.0.1
# Lokasi file database JSON lokal. Default: data/db.json
DATA_FILE=data/db.json
